# Maintainer: Sophana Sok <sokdevelopment@gmail.com>
#
# The prebuilt release archive, for anyone who does not want a Rust toolchain
# to read a markdown file. `marquee-markdown` builds the same program from
# source; the two conflict, because both install the same binaries.
#
# The archives already carry the man pages and the completions, generated by
# the binaries during the release build — so unlike the source package this
# one only has to put files where they go.

pkgname=marquee-markdown-bin
_pkgname=marquee-markdown
pkgver=0.9.0
pkgrel=1
pkgdesc="TUI markdown reader that renders documents like Claude artifacts (prebuilt binary)"
arch=('x86_64')
url="https://github.com/SophanaSok/marquee-markdown"
license=('MIT')
# `libgcc` and `glibc`, not `gcc-libs`: the binary's only NEEDED libraries are
# libgcc_s.so.1, libm.so.6 and libc.so.6, and current Arch has split gcc-libs
# into components — it now pulls libstdc++, libasan, libgfortran and nine more
# onto a system that wants a markdown reader. namcap says so, twice.
depends=('glibc' 'libgcc')
provides=("marquee-markdown=$pkgver")
conflicts=('marquee-markdown')
options=('!strip' '!debug')
source_x86_64=("$pkgname-$pkgver-$CARCH.tar.gz::$url/releases/download/v$pkgver/$_pkgname-v$pkgver-$CARCH-linux.tar.gz")
# From the release's `checksums.txt`, which the release workflow writes.
sha256sums_x86_64=('504411f72b3e173c48263759cb258214ece1938dc27643d3c61441471082bdbf')

package() {
  cd "$_pkgname-v$pkgver-$CARCH-linux"

  install -Dm755 marquee-markdown "$pkgdir/usr/bin/marquee-markdown"
  install -Dm755 mmd "$pkgdir/usr/bin/mmd"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  local name
  for name in marquee-markdown mmd; do
    install -Dm644 "man/$name.1" "$pkgdir/usr/share/man/man1/$name.1"
    install -Dm644 "completions/$name.bash" \
      "$pkgdir/usr/share/bash-completion/completions/$name"
    # The archive names these `<name>.<shell>`; zsh wants `_<name>`.
    install -Dm644 "completions/$name.zsh" \
      "$pkgdir/usr/share/zsh/site-functions/_$name"
    install -Dm644 "completions/$name.fish" \
      "$pkgdir/usr/share/fish/vendor_completions.d/$name.fish"
  done
}
