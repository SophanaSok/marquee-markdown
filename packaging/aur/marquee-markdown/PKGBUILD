# Maintainer: Sophana Sok <sokdevelopment@gmail.com>
#
# Builds from the tag's source tarball. `marquee-markdown-bin` is the same
# program from the release archive, for anyone who does not want a Rust
# toolchain — the two conflict, because both install the same binaries.
#
# The `sha256sums` line pins the tarball for the tag and cannot be computed
# before the tag exists, so this is bumped after pushing one, exactly as the
# Homebrew formula is.

pkgname=marquee-markdown
pkgver=0.11.0
pkgrel=1
pkgdesc="TUI markdown reader that renders documents like Claude artifacts, with a table-of-contents panel"
arch=('x86_64' 'aarch64')
url="https://github.com/SophanaSok/marquee-markdown"
license=('MIT')
# `libgcc` and `glibc`, not `gcc-libs`: the binary's only NEEDED libraries are
# libgcc_s.so.1, libm.so.6 and libc.so.6, and current Arch has split gcc-libs
# into components — it now pulls libstdc++, libasan, libgfortran and nine more
# onto a system that wants a markdown reader. namcap says so, twice.
depends=('glibc' 'libgcc')
makedepends=('cargo')
# `!lto` because makepkg turns LTO on by default and this cannot use it.
# TLS comes from rustls, which reaches `aws-lc-sys` — a C library shipped as a
# static archive built without LTO bitcode. Linking it under `-flto=auto` with
# `-Clinker-plugin-lto` drops every symbol it defines, and the build ends in a
# page of `undefined symbol: aws_lc_0_44_0_*`. Nothing here is hot enough to
# miss the optimisation.
# `!debug` because `[profile.release]` in Cargo.toml sets `strip = true`, so
# there are no symbols left for makepkg's debug package to collect however
# much `-C debuginfo=2` it passes. Without this it builds one anyway: an empty
# usr/src/debug and two build-id symlinks pointing at nothing, which namcap
# reports as errors. Stripping is upstream's choice for binary size and not
# something a package should quietly undo.
options=('!lto' '!debug')
conflicts=('marquee-markdown-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8761c8110e959e6acf51f12048734a4f65f59b5f39fb68932e8d11e12259ba38')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The live-forge checks are `#[ignore]`d, so this needs no network.
  # `--all-features` rather than `--all-targets`: it is what the Rust
  # package guidelines specify, it matches build(), and it runs the
  # doctest on the public render example, which `--all-targets` skips.
  cargo test --frozen --all-features
}

package() {
  cd "$pkgname-$pkgver"

  # Both names, as two real binaries rather than a symlink, so an AUR install
  # matches every other install method.
  install -Dm755 "target/release/marquee-markdown" "$pkgdir/usr/bin/marquee-markdown"
  install -Dm755 "target/release/mmd" "$pkgdir/usr/bin/mmd"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # Generated by the binaries themselves, so they cannot drift from the flags
  # actually accepted. Completions are registered under whichever name is
  # invoked, so both names need their own.
  local name
  for name in marquee-markdown mmd; do
    "target/release/$name" man > "$name.1"
    install -Dm644 "$name.1" "$pkgdir/usr/share/man/man1/$name.1"

    "target/release/$name" completion bash > "$name.bash"
    install -Dm644 "$name.bash" "$pkgdir/usr/share/bash-completion/completions/$name"

    "target/release/$name" completion zsh > "_$name"
    install -Dm644 "_$name" "$pkgdir/usr/share/zsh/site-functions/_$name"

    "target/release/$name" completion fish > "$name.fish"
    install -Dm644 "$name.fish" "$pkgdir/usr/share/fish/vendor_completions.d/$name.fish"
  done
}
