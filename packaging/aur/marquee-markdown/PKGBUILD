# Maintainer: Sophana Sok <sokdevelopment@gmail.com>
#
# Builds from the tag's source tarball. `marquee-markdown-bin` is the same
# program from the release archive, for anyone who does not want a Rust
# toolchain — the two conflict, because both install the same binaries.
#
# The `sha256sums` line pins the tarball for the tag and cannot be computed
# before the tag exists, so this is bumped after pushing one, exactly as the
# Homebrew formula is.

pkgname=marquee-markdown
pkgver=0.6.1
pkgrel=1
pkgdesc="TUI markdown reader that renders documents like Claude artifacts, with a table-of-contents panel"
arch=('x86_64' 'aarch64')
url="https://github.com/SophanaSok/marquee-markdown"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
provides=('mmd')
conflicts=('marquee-markdown-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5313ca52a29d401f969c631b39a0dc16eeef8abf67e6d339df3e553b948e28c1')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The live-forge checks are `#[ignore]`d, so this needs no network.
  cargo test --frozen --all-targets
}

package() {
  cd "$pkgname-$pkgver"

  # Both names, as two real binaries rather than a symlink, so an AUR install
  # matches every other install method.
  install -Dm755 "target/release/marquee-markdown" "$pkgdir/usr/bin/marquee-markdown"
  install -Dm755 "target/release/mmd" "$pkgdir/usr/bin/mmd"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # Generated by the binaries themselves, so they cannot drift from the flags
  # actually accepted. Completions are registered under whichever name is
  # invoked, so both names need their own.
  local name
  for name in marquee-markdown mmd; do
    "target/release/$name" man > "$name.1"
    install -Dm644 "$name.1" "$pkgdir/usr/share/man/man1/$name.1"

    "target/release/$name" completion bash > "$name.bash"
    install -Dm644 "$name.bash" "$pkgdir/usr/share/bash-completion/completions/$name"

    "target/release/$name" completion zsh > "_$name"
    install -Dm644 "_$name" "$pkgdir/usr/share/zsh/site-functions/_$name"

    "target/release/$name" completion fish > "$name.fish"
    install -Dm644 "$name.fish" "$pkgdir/usr/share/fish/vendor_completions.d/$name.fish"
  done
}
