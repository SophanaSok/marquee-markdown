{
  "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
  "version": "@VERSION@",
  "description": "TUI markdown reader that renders documents like Claude artifacts",
  "homepage": "https://marquee-markdown.com/",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/SophanaSok/marquee-markdown/releases/download/v@VERSION@/marquee-markdown-v@VERSION@-x86_64-windows.zip",
      "hash": "@HASH@",
      "extract_dir": "marquee-markdown-v@VERSION@-x86_64-windows"
    }
